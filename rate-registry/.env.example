# WhatIff rate registry — environment values
#
# There is no build step, so nothing reads this .env at runtime. It exists to
# (a) document the two values you need, and (b) feed the Netlify build snippet
# in the README that generates config.js from environment variables.
#
# Find both under Supabase: Project Settings -> API.
#   - Project URL
#   - Project API keys -> "anon" / "public" key  (safe to expose; RLS protects data)

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
