# WhatIff home-loan registry — environment values
#
# Used by the Netlify build (scripts/write-config.mjs writes config.js from
# these; scripts/build-aggregates.mjs reads them to pre-render /rates/ pages).
# There is no runtime server, so nothing reads this at request time.
#
# Find the first two under Supabase: Project Settings -> API.
#   - Project URL
#   - Project API keys -> "anon" / "public" key  (safe to expose; RLS protects data)

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional: your production origin, used only for canonical/Dataset URLs in the
# static aggregate pages. Defaults to a placeholder if unset.
SITE_URL=https://your-site.netlify.app
